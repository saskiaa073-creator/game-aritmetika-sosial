# Salin file ini menjadi .env (start.bat melakukannya otomatis).
# JANGAN unggah .env ke GitHub. File .env sudah ada di .gitignore.

# Kunci rahasia untuk token login. start.bat mengisinya otomatis dengan nilai acak.
SECRET_KEY=

# Kosongkan untuk memakai SQLite (data/pasar_pintar.db).
# Contoh PostgreSQL: postgresql+psycopg://user:sandi@host:5432/nama_db
DATABASE_URL=

# 1 = buat akun demo (guru_demo / guru12345, siswa_demo / siswa12345, kode kelas DEMO77)
DEMO_SEED=1

# Sasaran poin harian siswa
SASARAN_HARIAN=30

# Alamat frontend lain yang boleh memanggil API, dipisah koma (untuk Netlify nanti)
ALLOWED_ORIGINS=

# ---------------------------------------------------------------
# Asisten Belajar AI (model RMT)
# Isi SENDIRI langsung di file .env. JANGAN kirim kunci ke chat atau GitHub.
# Tanpa kunci, asisten tetap jalan dengan teks bawaan.
# Setelah diisi, cek dengan:  .\.venv\Scripts\python.exe -m apps.api.cek_ai
# ---------------------------------------------------------------
# gemini (bawaan) atau deepseek
AI_PROVIDER=gemini
# Kunci dari aistudio.google.com (Get API key) atau platform.deepseek.com
AI_API_KEY=
# Nama model; lihat daftarnya dengan cek_ai. DeepSeek bawaan: deepseek-chat
AI_MODEL=
# Batas pesan asisten per siswa per hari
AI_KUOTA_HARIAN=20
# Opsional: alamat lain yang kompatibel OpenAI; kosongkan untuk bawaan
AI_BASE_URL=
# Opsional: low / medium / high (kosongkan bila ragu)
AI_REASONING_EFFORT=
